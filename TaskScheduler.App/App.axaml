<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="TaskScheduler.App.App"
             xmlns:local="using:TaskScheduler.App"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- 全局排版基线：字号与字体族在此统一，供主题未显式指定字体的控件（含脚本编辑器）回落使用。
                 这是有意的应用级设定，不属于「仅编辑器生效」的局部样式。 -->
            <sys:Double x:Key="ControlContentThemeFontSize">14</sys:Double>
            <FontFamily x:Key="ContentControlThemeFontFamily">Inter, $Default</FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="DialogOverlayColor">#80000000</Color>
                    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#80000000" />
                    <SolidColorBrush x:Key="DialogPanelBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="DialogOverlayColor">#B3000000</Color>
                    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="DialogPanelBackgroundBrush" Color="#2D2D30" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />

        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <avalonia:MaterialIconStyles />

        <semi:DataGridSemiTheme />
    </Application.Styles>
</Application>
